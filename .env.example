# Local PostgreSQL credentials (never commit real values)
POSTGRES_DB_PASSWORD=replace_me
DB_URL=jdbc:postgresql://127.0.0.1:5432/memory_db
DB_USERNAME=postgres

# Local Spring Boot binding
APP_PORT=8080
SPRING_PROFILES_ACTIVE=local

# MCP auth (recommended for any remote endpoint)
MCP_AUTH_ENABLED=false
MCP_AUTH_HEADER_NAME=X-MCP-API-KEY
MCP_AUTH_TOKEN=replace_with_long_random_secret
MCP_DB_ADMIN_ENABLED=false
MCP_DB_ADMIN_ALLOW_DDL=false
MCP_DB_ADMIN_DEFAULT_QUERY_LIMIT=200
MCP_DB_ADMIN_MAX_QUERY_LIMIT=1000

# Optional Railway variables
PORT=8080
APP_MCP_PUBLIC_BASE_URL=

